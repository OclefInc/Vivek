<% content_for :title, "Account" %>
<div class="flex flex-col items-center max-w-7xl mx-auto ">
  <div class="xl:min-w-[640px] xl:max-w-[640px] md:flex-1 md:basis-1/2 mb-4 xl:mb-0">
    <%= render partial: "account", locals: {user: @account} %>
  </div>
  <div class="xl:min-w-[640px] xl:max-w-[640px] md:flex-1 md:basis-1/2">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 p-6">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">Employee Access</h2>
      <%= form_with model: @account, url: update_employee_account_path(@account), method: :patch, local: true do |form| %>
        <label class="inline-flex items-center gap-3">
          <%= form.check_box :is_employee, class: "rounded border-gray-300 dark:border-gray-600 text-blue-600 focus:ring-blue-500" %>
          <span class="text-sm text-gray-700 dark:text-gray-300">Grant employee access</span>
        </label>
        <div class="mt-4">
          <%= form.submit "Save", class: "inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors" %>
        </div>
      <% end %>
    </div>
  </div>
</div>